{
  "name": "mechanical-keyboard-store-simulator",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "art:layouts": "node --experimental-strip-types -e \"import('./src/data/layouts.ts').then(m=>{const o={};for(const id of m.LAYOUT_IDS)o[id]=m.getLayout(id);require('fs').writeFileSync('art/build/layouts.json',JSON.stringify(o))})\"",
    "art:preview": "~/.venvs/bpy/bin/python art/blender/poc_keyboard.py hero",
    "test:e2e": "node tests/e2e/smoke.cjs && node tests/e2e/audio.cjs && node tests/e2e/build.cjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.33.2",
    "@babylonjs/gui": "^9.33.2",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "earcut": "^3.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
